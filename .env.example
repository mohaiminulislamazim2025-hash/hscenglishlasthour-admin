# ---------------------------------------------------------------------------
# HSC English Last Hour — Admin Dashboard environment.
# Copy this file to `.env.local` and fill in the values from the existing
# Supabase project (Project Settings > API). Never commit real values.
#
# This dashboard connects to the SAME Supabase project as the public website
# (`bookproject`). Do not create a new project or bucket.
# ---------------------------------------------------------------------------

# Public project URL + browser-safe key. Exposed to the browser by design.
# The browser client is used only for Auth session management and for direct
# uploads to Storage via short-lived signed upload URLs.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Legacy fallback used only when the publishable key is unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Server-only privileged key. NEVER prefix with NEXT_PUBLIC_.
# Used by server-only code to: verify admin membership in `admin_users`, read
# and write book/order data that is otherwise protected by RLS + column grants,
# and mint signed upload/download URLs for the private `book-assets` bucket.
# Keep it secret. It is never sent to the browser.
# ---------------------------------------------------------------------------
SUPABASE_SECRET_KEY=""
# Legacy fallback used only when SUPABASE_SECRET_KEY is unset.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: storage bucket for book assets. Defaults to "book-assets".
SUPABASE_BOOK_BUCKET=""
