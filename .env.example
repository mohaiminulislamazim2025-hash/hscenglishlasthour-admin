# ---------------------------------------------------------------------------
# Nuri Shirt Store — Admin Dashboard environment.
# Copy this file to `.env.local` and fill in the values from the Supabase
# project (Project Settings > API). Never commit real values.
#
# This dashboard connects to the SAME Supabase project as the public Nuri Shirt
# Store website. Do not create a new project or bucket.
# ---------------------------------------------------------------------------

# Public project URL + browser-safe key. Exposed to the browser by design.
# The browser client is used only for Auth session management and for direct
# uploads to Storage via short-lived signed upload URLs.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Legacy fallback used only when the publishable key is unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Server-only privileged key. NEVER prefix with NEXT_PUBLIC_.
# Used by server-only code to read and write products, orders and store
# settings that are otherwise protected by RLS + column grants, and to mint
# signed upload/download URLs for the private product-images bucket.
# Keep it secret. It is never sent to the browser.
# ---------------------------------------------------------------------------
SUPABASE_SECRET_KEY=""
# Legacy fallback used only when SUPABASE_SECRET_KEY is unset.
SUPABASE_SERVICE_ROLE_KEY=""

# Storage bucket for product images. Defaults to "nuri-product-images".
# (The variable name is kept as-is for backwards compatibility.)
SUPABASE_BOOK_BUCKET=""

# ---------------------------------------------------------------------------
# Optional server-only allow-list of administrator emails, comma-separated.
# Primary admin authorization is the Supabase Auth user's `app_metadata.role`
# set to "admin"; this list is a convenience fallback for first-run setup.
# NEVER expose this to the browser.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=""
